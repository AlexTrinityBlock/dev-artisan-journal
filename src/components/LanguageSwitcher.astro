---
import { langMeta, locales, type Lang } from '../i18n/config';
import { localeHref } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Locale-less path of the current page, e.g. `/articles` or `/blog/2026/08-x`. */
  path: string;
  /** Locales where this exact page does not exist yet (links fall back to that locale's article index). */
  missing?: Lang[];
}

const { lang, path, missing = [] } = Astro.props;
const t = useTranslations(lang);
---

<nav class="lang-switch" aria-label={t.switcher.aria}>
  <span class="lang-tag" aria-hidden="true">{t.switcher.label} //</span>
  <ul class="lang-list">
    {locales.map((locale) => {
      const active = locale === lang;
      const pending = missing.includes(locale);
      const href = pending ? localeHref(locale, '/articles') : localeHref(locale, path);
      return (
        <li>
          <a
            class={`mono-btn-chamfer lang-btn${active ? ' is-active' : ''}${pending ? ' is-pending' : ''}`}
            href={href}
            hreflang={langMeta[locale].hreflang}
            lang={langMeta[locale].htmlLang}
            rel="alternate"
            title={pending ? t.switcher.pending : langMeta[locale].label}
            aria-current={active ? 'true' : undefined}
          >
            <span class="chamfer-inner">
              <span class="btn-label">{langMeta[locale].short}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .lang-tag {
    font-family: var(--mono-font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--mono-muted);
    white-space: nowrap;
  }

  .lang-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
  }

  /* Label-only chips: constant paper ground, 0.7px hairline wrapper.
     The current locale is marked by a permanent 0.8px ink underline rail. */
  .lang-btn .chamfer-inner {
    padding: 4px 9px;
    min-width: 26px;
    justify-content: center;
    font-family: var(--mono-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--mono-l3);
  }

  .lang-btn:hover .chamfer-inner {
    color: var(--mono-ink);
  }

  .lang-btn.is-active .chamfer-inner {
    color: var(--mono-ink);
    font-weight: 800;
  }

  .lang-btn.is-active .btn-label::after {
    transform: scaleX(1);
  }

  .lang-btn.is-pending .chamfer-inner {
    color: var(--mono-faint);
  }

  .lang-btn.is-pending .btn-label::after {
    background-color: var(--mono-faint);
  }

  @media (max-width: 600px) {
    .lang-tag {
      display: none;
    }
  }
</style>
