---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    
    <div class="footer-grid">
      <!-- Col 1: About the journal -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <span class="brand-title">DEV ARTISAN // JOURNAL</span>
          <p class="brand-desc">
            A technical publication focused on bare-metal GPU clustering, multi-agent AI orchestration, Kubernetes infrastructure, and ISO/IEC 27001 DevSecOps governance.
          </p>
        </div>
        <div class="footer-node-telemetry">
          <span class="telemetry-badge">OPERATIONAL // TAIPEI, TAIWAN</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col">
        <span class="col-title">NAVIGATION</span>
        <ul class="footer-links">
          <li><a href="/">Home &amp; Profile</a></li>
          <li><a href="/articles">Articles</a></li>
          <li><a href="/tags">Topics &amp; Taxonomy</a></li>
        </ul>
      </div>

      <!-- Col 3: Core Domains -->
      <div class="footer-col">
        <span class="col-title">DOMAINS</span>
        <ul class="footer-links">
          <li><a href="/tags/Kubernetes">Kubernetes &amp; vGPU</a></li>
          <li><a href="/tags/LangGraph">Multi-Agent Systems</a></li>
          <li><a href="/tags/ISO27001">ISO 27001 ISMS</a></li>
          <li><a href="/tags/FastAPI">FastAPI &amp; Python</a></li>
          <li><a href="/tags/Terraform">Cloud Infrastructure</a></li>
        </ul>
      </div>

      <!-- Col 4: Verified Credentials -->
      <div class="footer-col">
        <span class="col-title">CREDENTIALS</span>
        <ul class="footer-links">
          <li><a href="https://www.credly.com/badges/f2df353f-b36d-41d5-b652-fbcea74abc6c/public_url" target="_blank" rel="noopener noreferrer">NVIDIA GenAI LLMs ↗</a></li>
          <li><a href="https://www.credly.com/badges/fcbae132-9ad2-4995-ae14-6feeaa914d28/public_url" target="_blank" rel="noopener noreferrer">CNCF CKA Administrator ↗</a></li>
          <li><a href="https://www.credly.com/badges/13a54046-b8d0-40df-9094-8222ec7b0d2e" target="_blank" rel="noopener noreferrer">AWS Solutions Architect Pro ↗</a></li>
          <li><a href="https://www.credly.com/badges/d0031cb8-c858-4a63-8f54-521020f54a44" target="_blank" rel="noopener noreferrer">Google Cloud Architect (PCA) ↗</a></li>
          <li><a href="https://tksg.org/admin/tool/certificate/index.php?code=5615205852WH" target="_blank" rel="noopener noreferrer">ISO/IEC 27001 Lead Auditor ↗</a></li>
          <li><a href="https://ieeexplore.ieee.org/abstract/document/10210155" target="_blank" rel="noopener noreferrer">IEEE Xplore Publication ↗</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="bottom-copy">
        &copy; {currentYear} Alex.Hsiao (Wei-Chun Hsiao). Crafted with Astro &amp; Design Token Mono Palette.
      </div>
      <div class="bottom-meta">
        <span>FONT: INTER / MONO</span>
        <span>·</span>
        <span>PALETTE: #1C1C1A / #F0EFEB</span>
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: var(--mono-card-bg);
    border-top: 1px solid var(--mono-grid);
    margin-top: auto;
    padding: 48px 0 28px;
    font-size: 13px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 36px;
    margin-bottom: 40px;
  }

  .brand-title {
    font-family: var(--mono-font-mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--mono-ink);
    display: block;
    margin-bottom: 10px;
  }

  .brand-desc {
    color: var(--mono-l3);
    line-height: 1.6;
    font-size: 12.5px;
    max-width: 380px;
    margin-bottom: 16px;
  }

  .telemetry-badge {
    display: inline-block;
    font-family: var(--mono-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--mono-l2);
    background: var(--mono-bg-subtle);
    border: 1px solid var(--mono-grid);
    padding: 3px 8px;
    border-radius: 4px;
  }

  .col-title {
    font-family: var(--mono-font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--mono-muted);
    display: block;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    color: var(--mono-l2);
    font-size: 12.5px;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--mono-ink);
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px dashed var(--mono-grid);
    font-family: var(--mono-font-mono);
    font-size: 11px;
    color: var(--mono-muted);
    flex-wrap: wrap;
    gap: 12px;
  }

  .bottom-meta {
    display: flex;
    gap: 8px;
    font-size: 10px;
    color: var(--mono-faint);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
