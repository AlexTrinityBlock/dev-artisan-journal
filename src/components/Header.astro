---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/articles', label: 'Articles' },
  { href: '/tags', label: 'Topics' },
];
---

<header class="site-header">
  <div class="container header-container">
    
    <!-- Logo & Status Beacon -->
    <a href="/" class="site-logo">
      <div class="beacon-node" title="System Active: Taipei Node">
        <span class="beacon-pulse"></span>
        <span class="beacon-core"></span>
      </div>
      <div class="logo-text">
        <span class="logo-title">DEV ARTISAN <span class="logo-sep">//</span> JOURNAL</span>
        <span class="logo-sub">Alex.Hsiao · FullStack &amp; GenAI Architect</span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' || currentPath.startsWith('/blog')
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a 
                href={item.href} 
                class={`nav-link ${isActive ? 'active' : ''}`}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Quick Actions -->
      <div class="nav-actions">
        <a href="mailto:q123717111@gmail.com" class="mono-btn-chamfer header-contact-btn" title="Send Email">
          <span class="chamfer-inner">
            <span class="btn-tag">SYS //</span>
            <span class="btn-label">Contact</span>
          </span>
        </a>
      </div>
    </nav>

  </div>
</header>

<style>
  .site-header {
    background: var(--mono-card-bg);
    border-bottom: 0.7px solid var(--mono-grid);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    gap: 20px;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .beacon-node {
    position: relative;
    width: 10px;
    height: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .beacon-core {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mono-ink);
  }

  .beacon-pulse {
    position: absolute;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 0.7px dashed var(--mono-muted);
    animation: pulse 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.7); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.2; }
    100% { transform: scale(0.7); opacity: 1; }
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-family: var(--mono-font-mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--mono-ink);
  }

  .logo-sep {
    color: var(--mono-muted);
    font-weight: 400;
  }

  .logo-sub {
    font-size: 10.5px;
    color: var(--mono-muted);
    font-weight: 500;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
  }

  .nav-link {
    font-family: var(--mono-font-mono);
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--mono-tag-radius);
    color: var(--mono-l3);
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    color: var(--mono-ink);
    background: var(--mono-bg-subtle);
  }

  .nav-link.active {
    color: var(--mono-paper);
    background: var(--mono-ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    border-left: 0.7px solid var(--mono-grid);
    padding-left: 16px;
  }

  .header-contact-btn .chamfer-inner {
    padding: 6px 12px;
    font-size: 11px;
  }

  @media (max-width: 768px) {
    .header-container {
      height: auto;
      padding-top: 14px;
      padding-bottom: 14px;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .site-nav {
      width: 100%;
      justify-content: space-between;
    }

    .nav-list {
      gap: 2px;
    }

    .nav-link {
      padding: 5px 8px;
      font-size: 11px;
    }

    .nav-actions {
      padding-left: 8px;
    }
  }
</style>
