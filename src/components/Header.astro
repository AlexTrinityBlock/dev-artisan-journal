---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'HOME', tag: '01 //' },
  { href: '/articles', label: 'ARTICLES', tag: '02 //' },
  { href: '/tags', label: 'TOPICS', tag: '03 //' },
];
---

<header class="site-header">
  <div class="container header-container">
    
    <!-- Logo & Status Beacon -->
    <a href="/" class="site-logo">
      <div class="beacon-node" title="System Active: Taipei Node">
        <svg class="hex-beacon" width="42" height="42" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- 0. Circumscribed Outer Circle (R=21, precisely passes through all 6 vertices of Outer Hex) -->
          <circle class="geo-outer-circle" cx="24" cy="24" r="21" stroke="var(--mono-muted)" stroke-width="0.8" vector-effect="non-scaling-stroke" fill="none" />
          <!-- 1. Outer Hexagon (Flat-topped & Flat-bottomed, R=21) -->
          <polygon class="geo-outer-hex" points="45,24 34.5,5.81 13.5,5.81 3,24 13.5,42.19 34.5,42.19" stroke="var(--mono-muted)" stroke-width="0.8" vector-effect="non-scaling-stroke" fill="none" />
          <!-- 2. Middle Hexagon (Pointy-topped / Midpoint-Inscribed, r=18.19) -->
          <polygon class="geo-mid-hex" points="24,5.81 39.75,14.91 39.75,33.09 24,42.19 8.25,33.09 8.25,14.91" stroke="var(--mono-muted)" stroke-width="0.8" vector-effect="non-scaling-stroke" fill="none" />
          <!-- 3. Inscribed Equilateral Triangle (3 Vertices Coincident with Inner Hex Vertices) -->
          <polygon class="geo-inner-tri" points="8.25,14.91 39.75,14.91 24,42.19" stroke="var(--mono-muted)" stroke-width="0.8" vector-effect="non-scaling-stroke" fill="none" />
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-title">DEV ARTISAN <span class="logo-sep">//</span> JOURNAL</span>
        <span class="logo-sub">Alex.Hsiao · FullStack &amp; GenAI Architect</span>
      </div>
    </a>

    <!-- Navigation -->
    <nav class="site-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive = item.href === '/' 
            ? currentPath === '/' || currentPath.startsWith('/blog')
            : currentPath.startsWith(item.href);
          return (
            <li>
              <a 
                href={item.href} 
                class={`mono-btn-chamfer header-nav-btn ${isActive ? 'active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="chamfer-inner">
                  <span class="btn-tag">{item.tag}</span>
                  <span class="btn-label">{item.label}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Quick Actions -->
      <div class="nav-actions">
        <a href="mailto:q123717111@gmail.com" class="mono-btn-chamfer header-contact-btn" title="Send Email">
          <span class="chamfer-inner">
            <span class="btn-tag">SYS //</span>
            <span class="btn-label">CONTACT</span>
          </span>
        </a>
      </div>
    </nav>

  </div>
</header>

<style>
  .site-header {
    background: var(--mono-card-bg);
    border-bottom: 0.7px solid var(--mono-grid);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    gap: 20px;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .beacon-node {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
  }

  .hex-beacon {
    width: 42px;
    height: 42px;
    display: block;
    overflow: visible;
  }

  .geo-outer-circle,
  .geo-outer-hex,
  .geo-mid-hex,
  .geo-inner-tri {
    stroke: var(--mono-muted);
    stroke-width: 0.8px;
    fill: none;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 34px;
  }

  .logo-title {
    font-family: var(--mono-font-mono);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--mono-ink);
    line-height: 1.2;
  }

  .logo-sep {
    color: var(--mono-muted);
    font-weight: 400;
  }

  .logo-sub {
    font-size: 10.5px;
    color: var(--mono-muted);
    font-weight: 500;
    line-height: 1.25;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
  }

  .header-nav-btn .chamfer-inner,
  .header-contact-btn .chamfer-inner {
    padding: 6px 12px;
    font-size: 11px;
    gap: 6px;
  }

  .header-nav-btn .btn-tag,
  .header-contact-btn .btn-tag {
    font-size: 9.5px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    border-left: 0.7px solid var(--mono-grid);
    padding-left: 14px;
  }

  @media (max-width: 820px) {
    .header-container {
      height: auto;
      padding-top: 14px;
      padding-bottom: 14px;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .site-nav {
      width: 100%;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 10px;
    }

    .nav-list {
      flex-wrap: wrap;
      gap: 6px;
    }

    .header-nav-btn .chamfer-inner,
    .header-contact-btn .chamfer-inner {
      padding: 5px 10px;
      font-size: 10.5px;
      gap: 5px;
    }

    .header-nav-btn .btn-tag,
    .header-contact-btn .btn-tag {
      font-size: 9px;
    }

    .nav-actions {
      padding-left: 0;
      border-left: none;
    }
  }
</style>
