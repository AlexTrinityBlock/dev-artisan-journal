---
interface Props {
  post: {
    id: string;
    slug?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags: string[];
      featured?: boolean;
      readTime?: string;
      author?: string;
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const slug = (post.slug || post.id).replace(/\/index$/, "").replace(/\.[^/.]+$/, "");
const postUrl = `/blog/${slug}`;
const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<div 
  class={`chamfer-card-wrapper article-card-wrapper ${featured ? 'featured-card' : ''}`}
  data-href={postUrl}
  onclick="if (!event.target.closest('a')) window.location.href = this.dataset.href;"
  role="link"
  tabindex="0"
  onkeydown="if (event.key === 'Enter' && !event.target.closest('a')) window.location.href = this.dataset.href;"
>
  <article class="chamfer-card-content article-card-inner">
    <!-- Card Header Meta -->
    <div class="card-meta">
      <span class="card-tag">{post.data.category}</span>
      <span class="meta-separator">·</span>
      <time datetime={post.data.pubDate.toISOString()} class="date-text">{formattedDate}</time>
      <span class="meta-separator">·</span>
      <span class="read-time">{post.data.readTime || '5 min read'}</span>
      {featured && <span class="featured-badge">FEATURED</span>}
    </div>

    <!-- Title -->
    <h3 class={`article-title ${featured ? 'big-title' : ''}`}>
      <a href={postUrl} class="title-link">
        {post.data.title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class="article-desc">
      {post.data.description}
    </p>

    <!-- Tags & Footer Link -->
    <div class="card-footer">
      <div class="tags-group">
        {post.data.tags.map((tag) => (
          <a href={`/tags/${tag}`} class="tag">
            #{tag}
          </a>
        ))}
      </div>

      <a href={postUrl} class="mono-btn-chamfer read-btn">
        <span class="chamfer-inner">
          <span class="btn-tag">DISPATCH //</span>
          <span class="btn-label">Read &rarr;</span>
        </span>
      </a>
    </div>
  </article>
</div>

<style>
  .article-card-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    width: 100%;
    background-color: var(--mono-grid);
    padding: var(--mono-border-w, 0.7px);
    clip-path: polygon(
      0 0,
      calc(100% - var(--mono-chamfer-cut, 16px)) 0,
      100% var(--mono-chamfer-cut, 16px),
      100% 100%,
      var(--mono-chamfer-cut, 16px) 100%,
      0 calc(100% - var(--mono-chamfer-cut, 16px))
    );
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    user-select: none;
  }

  .article-card-wrapper:hover {
    transform: translateY(-2px);
  }

  .article-card-wrapper:hover .title-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .featured-card {
    background-color: var(--mono-grid);
  }

  .article-card-inner {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background-color: var(--mono-card-bg);
    padding: 24px 22px 20px;
    clip-path: polygon(
      0 0,
      calc(100% - var(--mono-chamfer-cut, 16px)) 0,
      100% var(--mono-chamfer-cut, 16px),
      100% 100%,
      var(--mono-chamfer-cut, 16px) 100%,
      0 calc(100% - var(--mono-chamfer-cut, 16px))
    );
  }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    font-family: var(--mono-font-mono);
    font-size: 11px;
    color: var(--mono-muted);
  }

  .card-tag {
    font-family: var(--mono-font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--mono-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--mono-paper);
    padding: 2px 8px;
    border-radius: var(--mono-tag-radius);
    border: 0.7px solid var(--mono-grid);
    margin-bottom: 0;
  }

  .featured-badge {
    background: var(--mono-paper);
    border: 0.7px solid var(--mono-grid);
    color: var(--mono-ink);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border-radius: var(--mono-tag-radius);
    margin-left: auto;
  }

  .meta-separator {
    color: var(--mono-faint);
  }

  .date-text, .read-time {
    font-size: 11px;
    color: var(--mono-muted);
  }

  .article-title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 10px 0;
    color: var(--mono-ink);
    letter-spacing: -0.02em;
  }

  .article-title.big-title {
    font-size: 19px;
    font-weight: 800;
  }

  .title-link {
    color: var(--mono-ink);
    text-decoration: none;
  }

  .title-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .article-desc {
    margin: 0 0 20px 0;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--mono-l2);
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border-top: 0.7px dashed var(--mono-grid);
    flex-wrap: wrap;
  }

  .tags-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .read-btn .chamfer-inner {
    padding: 6px 12px;
    font-size: 11px;
  }

  @media (max-width: 600px) {
    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
