<script is:inline src={`${baseUrl}/js/echarts.min.js`}></script>
<script is:inline>
  (function() {
    var INK = '#1C1C1A', PAPER = '#F0EFEB', MUTED = '#8F8E88', GRID = '#DEDDD6';

    var obsReveal = function(id, fn) {
      var n = document.getElementById(id);
      if (!n) return;
      var rendered = false;
      var go = function() {
        if (rendered) return;
        rendered = true;
        fn(n);
      };

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(es) {
          if (es[0].isIntersecting) {
            go();
            io.disconnect();
          }
        }, { threshold: 0.1 });
        io.observe(n);
      }
      // Safety fallback: render anyway if not triggered after 400ms
      setTimeout(go, 400);
    };

    var mapEl = document.getElementById('dispatch-world-map');
    var worldUrl = (mapEl && mapEl.dataset.worldUrl) || '/geojson/world.json';

    fetch(worldUrl)
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP error ' + r.status);
        return r.json();
      })
      .then(function(geo) {
        echarts.registerMap('mono-world', geo);
        var opt = {
          animationDuration: 900,
          animationEasing: 'quarticOut',
          tooltip: {
            backgroundColor: INK,
            borderWidth: 0,
            padding: [10, 14],
            textStyle: {
              color: PAPER,
              fontFamily: 'Inter, JetBrains Mono, sans-serif',
              fontSize: 12
            },
            formatter: function(p) {
              if (p.name === 'Taiwan') {
                return '<span style=\"font-weight:700;letter-spacing:0.05em;\">PRIMARY NODE // TAIPEI, TAIWAN</span><br/><span style=\"color:#C6C5BF;font-size:10px;\">25.0330° N, 121.5654° E · UTC+8 (CST)</span><br/><span style=\"color:#D8D7D1;font-size:10px;\">Taipei Hybrid / On-Site &amp; Global Remote</span>';
              }
              return (p.name || 'Territory');
            }
          },
          series: [{
            type: 'map',
            map: 'mono-world',
            top: 'middle',
