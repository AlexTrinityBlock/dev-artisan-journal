---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const skillGroups = [
  {
    tag: 'SYSTEM // ML & INFERENCE',
    title: 'GenAI & Machine Learning',
    skills: [
      { name: 'vLLM Inference Engine', level: 'Enterprise' },
      { name: 'LangGraph Multi-Agents', level: 'Production' },
      { name: 'HAMi vGPU Slicing', level: 'Enterprise' },
      { name: 'NVIDIA GPU Operator', level: 'Production' },
      { name: 'PyTorch & TensorFlow', level: '~3 Years' },
    ],
    synopsis: 'Architecting containerized GPU clusters on bare-metal Kubernetes with NVIDIA GPU Operator and HAMi vGPU dynamic slicing to maximize compute density and hardware utilization. Designing stateful, autonomous multi-agent orchestration pipelines with LangGraph and low-latency LLM streaming inference endpoints via vLLM.',
    stack: 'K8s GPU Operator · HAMi · LangGraph · vLLM · PyTorch · HuggingFace'
  },
  {
    tag: 'SYSTEM // BACKEND & AMQP',
    title: 'FullStack & Distributed Systems',
    skills: [
      { name: 'FastAPI / Python', level: '~3 Years' },
      { name: 'Node.js (Async Runtimes)', level: '~3 Years' },
      { name: 'RabbitMQ (AMQP Broker)', level: 'Production' },
      { name: 'Django / Flask', level: '~2 Years' },
      { name: 'PHP / Laravel', level: '~1 Year' },
    ],
    synopsis: 'Engineering high-throughput, non-blocking asynchronous microservices and reactive interfaces using FastAPI, modern Node.js, and React. Implementing enterprise AMQP message broker topologies with RabbitMQ to decouple critical distributed workloads and ensure reliable, fault-tolerant asynchronous task execution.',
    stack: 'FastAPI · Python · React.js · Node.js · RabbitMQ · RESTful / WebSockets'
  },
  {
    tag: 'SYSTEM // K8S & CLOUD',
    title: 'Cloud Fabric & Orchestration',
    skills: [
      { name: 'Kubernetes (CKA Certified)', level: '~2 Years' },
      { name: 'AWS Cloud (SAP Certified)', level: '~3 Years' },
      { name: 'Google Cloud (PCA Certified)', level: '~3 Years' },
      { name: 'Terraform (IaC Automation)', level: 'Production' },
      { name: 'Docker & Podman', level: '~3 Years' },
    ],
    synopsis: 'Certified across Kubernetes (CKA), AWS Solutions Architect Professional (SAP), and GCP Professional Cloud Architect (PCA). Designing declarative Infrastructure as Code (IaC) with Terraform, orchestrating production container fabrics, executing complex cross-cloud migrations, and establishing zero-trust security baselines.',
    stack: 'Kubernetes · Terraform · AWS · Google Cloud · Ansible · RBAC & WAF'
  },
  {
    tag: 'SYSTEM // STORAGE & HA',
    title: 'Databases & Resilient Storage',
    skills: [
      { name: 'PostgreSQL', level: '~3 Years' },
      { name: 'Microsoft SQL Server', level: 'Enterprise' },
      { name: 'MongoDB & MySQL', level: '~3 Years' },
      { name: 'Longhorn HA Block Storage', level: 'Enterprise' },
      { name: 'MinIO / S3 Parquet', level: 'Production' },
    ],
    synopsis: 'Structuring highly resilient, low-latency relational and document database layers across PostgreSQL, Microsoft SQL Server, and MongoDB. Deploying cloud-native distributed persistent block storage with Longhorn replication in Kubernetes alongside MinIO S3 object storage for analytical Parquet storage.',
    stack: 'PostgreSQL · SQL Server · MongoDB · Longhorn · MinIO / S3 · Redis'
  },
];

const certifications = [
  {
    tag: 'CREDENTIAL // 01 · GENAI',
    title: 'NVIDIA Certified Professional: Generative AI LLMs',
    issuer: 'NVIDIA // CREDLY VERIFIED',
    id: 'f2df353f-b36d-41d5-b652-fbcea74abc6c',
    url: 'https://www.credly.com/badges/f2df353f-b36d-41d5-b652-fbcea74abc6c/public_url',
    image: `${baseUrl}/images/certifications/nvidia-genai-llms-full.png`,
    description: 'Validates enterprise mastery in building, deploying, and accelerating large language model architectures. Encompasses parameter-efficient fine-tuning (PEFT/LoRA), vLLM & Triton inference serving, retrieval-augmented generation (RAG), and production LLM evaluation.',
    meta: 'NVIDIA Deep Learning Institute · Verified'
  },
  {
    tag: 'CREDENTIAL // 02 · CLOUD NATIVE',
    title: 'Certified Kubernetes Administrator (CKA)',
    issuer: 'LINUX FOUNDATION / CNCF',
    id: 'fcbae132-9ad2-4995-ae14-6feeaa914d28',
    url: 'https://www.credly.com/badges/fcbae132-9ad2-4995-ae14-6feeaa914d28/public_url',
    image: `${baseUrl}/images/certifications/cka-full.png`,
    description: 'Demonstrates production competence in Kubernetes cluster architecture, core component troubleshooting, networking (CNI/Ingress), storage volumes (CSI), cluster security, RBAC policies, and container workload maintenance.',
    meta: 'Cloud Native Computing Foundation · Verified'
  },
  {
    tag: 'CREDENTIAL // 03 · CLOUD ARCHITECTURE',
    title: 'AWS Certified Solutions Architect – Professional (SAP)',
    issuer: 'AMAZON WEB SERVICES',
    id: '13a54046-b8d0-40df-9094-8222ec7b0d2e',
    url: 'https://www.credly.com/badges/13a54046-b8d0-40df-9094-8222ec7b0d2e',
    image: `${baseUrl}/images/certifications/aws-sap-full.png`,
    description: 'Pinnacle AWS professional credential validating advanced expertise in complex multi-tier enterprise architecture, multi-account governance (AWS Control Tower), high availability, disaster recovery, cost optimization, and hybrid cloud migrations.',
    meta: 'Amazon Web Services · SAP-C02 Professional'
  },
  {
    tag: 'CREDENTIAL // 04 · CLOUD ARCHITECTURE',
    title: 'Google Cloud Professional Cloud Architect (PCA)',
    issuer: 'GOOGLE CLOUD',
    id: 'd0031cb8-c858-4a63-8f54-521020f54a44',
    url: 'https://www.credly.com/badges/d0031cb8-c858-4a63-8f54-521020f54a44',
    image: `${baseUrl}/images/certifications/gcp-pca-full.png`,
    description: 'Certifies comprehensive architecture competence on Google Cloud Platform, encompassing scalable microservice topologies on GKE, VPC network security, IAM least-privilege governance, data migration pipelines, and enterprise reliability engineering.',
    meta: 'Google Cloud Certified · Professional Tier'
  },
  {
    tag: 'CREDENTIAL // 05 · SECURITY GOVERNANCE',
    title: 'ISO/IEC 27001 Lead Auditor (Information Security)',
    issuer: 'TKSG // ISMS GOVERNANCE',
    id: '5615205852WH',
    url: 'https://tksg.org/admin/tool/certificate/index.php?code=5615205852WH',
    image: `${baseUrl}/images/certifications/iso27001-full.png`,
    description: 'Professional Lead Auditor certification validating deep knowledge in Information Security Management Systems (ISMS), risk assessment methodologies, Annex A security control implementation, compliance audits, and security baseline governance.',
    meta: 'TKSG ISMS Lead Auditor · Certified'
  },
  {
    tag: 'PUBLICATION // 06 · IEEE PEER-REVIEWED',
    title: 'IEEE Xplore: Deep Learning SQLi & XSS Detection',
    issuer: 'IEEE XPLORE // PEER REVIEWED',
    id: '10210155',
    url: 'https://ieeexplore.ieee.org/abstract/document/10210155',
    image: `${baseUrl}/images/paper/paper.png`,
    description: 'Peer-reviewed research publication in IEEE Xplore introducing a novel hybrid deep learning architecture combining Multi-Model CNN, Bidirectional GRU, and Multi-Head Self-Attention mechanisms for robust real-time detection of SQLi and XSS attacks.',
    meta: 'IEEE Xplore Doc: 10210155 · Master Thesis'
  },
];
---

<BaseLayout
  title="Alex.Hsiao (Wei-Chun Hsiao) — FullStack & GenAI Systems Architect"
  description="Curriculum Vitae and verified credentials of Alex.Hsiao — FullStack Engineer & GenAI Systems Architect. 5 professional certifications, IEEE publication, and ~3 years enterprise experience."
>
  <div class="container about-container">
    
    <!-- ════════ TOP HERO PROFILE (BORDERLESS EDITORIAL DESIGN) ════════ -->
    <section class="profile-hero-borderless">
      
      <!-- Top Section Header -->
      <div class="profile-meta-top">
        <span class="card-tag">SYSTEM // 01 · CANDIDATE PROFILE</span>
        <span class="role-pill">
          <span class="chamfer-inner">FULLSTACK &amp; GENAI ARCHITECT</span>
        </span>
      </div>

      <div class="profile-hero-layout">
        
        <div class="profile-avatar-block">
          <div class="avatar-frame">
            <img
              class="avatar-large"
              src={`${baseUrl}/images/avatar/avatar.jpg`}
              alt="Alex.Hsiao (Wei-Chun Hsiao) — FullStack &amp; GenAI Systems Architect"
              loading="lazy"
            />
          </div>
          <div class="status-indicator-badge">
            <span class="chamfer-inner">
              <span class="status-dot"></span>
              <span>ACTIVE // TAIPEI NODE</span>
            </span>
          </div>
        </div>

        <div class="profile-hero-content">
          <h1 class="profile-name">Alex Hsiao <span class="profile-alias">(Wei-Chun Hsiao)</span></h1>
          
          <p class="profile-intro-lead">
            Currently serving as a <strong>GenAI Engineer</strong> with hands-on expertise spanning full-stack application development, bare-metal GPU virtualization (NVIDIA GPU Operator &amp; HAMi), stateful Multi-Agent LLMs with LangGraph, distributed microservices, and ISO/IEC 27001 security compliance.
          </p>

          <div class="profile-quick-ledger">
            <div class="ledger-item">
              <span class="ledger-k">TARGET ROLES</span>
              <span class="ledger-v">FullStack Engineer / GenAI Systems Architect</span>
            </div>
            <div class="ledger-item">
              <span class="ledger-k">EXPERIENCE</span>
              <span class="ledger-v">~3 Years Enterprise FullStack &amp; ML</span>
            </div>
            <div class="ledger-item">
              <span class="ledger-k">EDUCATION</span>
              <span class="ledger-v">M.S. in CSIE, National Chiayi University</span>
            </div>
            <div class="ledger-item">
              <span class="ledger-k">LANGUAGE</span>
              <span class="ledger-v">English (~3 Yrs Professional Proficiency)</span>
            </div>
          </div>
        </div>

      </div>
      
      <div class="hero-divider"></div>
    </section>

    <!-- ════════ TECHNICAL SKILLS MATRIX ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">// 01 · PRODUCTION TECHNICAL TAXONOMY</span>
        <h2 class="head-title">End-to-End Technology Stack &amp; Infrastructure Tools</h2>
      </div>

      <div class="skills-category-list">
        {skillGroups.map((group) => (
          <div class="chamfer-card-wrapper skill-group-wrapper">
            <div class="chamfer-card-content skill-group-inner">
              
              <!-- Left Column: 240px Left Rail (Skills & Proficiency) -->
              <div class="group-left-rail">
                <div class="group-header">
                  <span class="card-tag">{group.tag}</span>
                  <h3 class="group-title">{group.title}</h3>
                </div>
                <div class="group-skills-stack">
                  {group.skills.map((skill) => (
                    <div class="skill-row">
                      <span class="skill-name">{skill.name}</span>
                      <span class="skill-level">{skill.level}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Right Column: 1fr (Integrated Production Architecture Narrative) -->
              <div class="group-right-content">
                <div class="group-synopsis-head">
                  <span class="synopsis-label">PRODUCTION ARCHITECTURE &amp; DEPLOYMENT CONTEXT</span>
                </div>
                <p class="group-synopsis-text">{group.synopsis}</p>
                <div class="group-stack-footer">
                  <span class="stack-footer-label">KEY STACK:</span> {group.stack}
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════ VERIFIED CERTIFICATIONS & PUBLICATIONS ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">// 02 · VERIFIED CREDENTIALS</span>
        <h2 class="head-title">Five Professional Certifications &amp; IEEE Peer-Reviewed Publication</h2>
        <p class="head-desc">100% authentic credentials with direct public verification badges.</p>
      </div>

      <div class="certs-list">
        {certifications.map((cert) => (
          <div class="chamfer-card-wrapper cert-card-wrapper">
            <div class="chamfer-card-content cert-card-inner">
              
              <!-- Left Column: 240px Left Rail (Portrait / Framed Certificate Exhibit) -->
              <div class="cert-portrait-rail">
                <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-portrait-frame" title="Click to verify certificate">
                  <img src={cert.image} alt={cert.title} loading="lazy" class="cert-portrait-img" />
                </a>
                <span class="cert-portrait-caption">{cert.meta}</span>
              </div>

              <!-- Right Column: 1fr (Comprehensive Credential Specification & Explanation) -->
              <div class="cert-right-content">
                <div class="cert-meta-header">
                  <span class="card-tag">{cert.tag}</span>
                  <span class="cert-issuer-badge">{cert.issuer}</span>
                </div>

                <h3 class="cert-name-text">
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-title-link">
                    {cert.title}
                  </a>
                </h3>

                <p class="cert-desc-text">{cert.description}</p>

                <div class="cert-footer-rail">
                  <div class="cert-id-badge">
                    <span class="cert-id-k">VERIFICATION ID:</span>
                    <span class="cert-id-v">{cert.id}</span>
                  </div>
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="mono-btn-chamfer cert-verify-btn">
                    <span class="chamfer-inner">
                      <span class="btn-tag">VERIFY //</span>
                      <span class="btn-label">Public Credential [↗]</span>
                    </span>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════ WORK EXPERIENCE CHRONICLE ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">// 03 · CAREER CHRONICLE</span>
        <h2 class="head-title">Professional Experience &amp; Research Trajectory</h2>
      </div>

      <div class="timeline-list">
        
        <!-- 01: Current Role -->
        <div class="chamfer-card-wrapper timeline-wrapper">
          <article class="chamfer-card-content timeline-inner">
            <div class="entry-meta">
              <span class="card-tag">NODE // CURRENT</span>
              <span class="entry-period">NOV 2025 – PRESENT</span>
              <span class="entry-company">Tatung System Technologies Inc. (Tatung World Tech)</span>
              <span class="entry-location">Zhongshan Dist., Taipei</span>
              <span class="entry-role">
                <span class="chamfer-inner">GenAI Engineer / AI Engineer</span>
              </span>
            </div>
            <div class="entry-content">
              <ul class="entry-bullets">
                <li>Lead developer for <strong>"AI Enhance Management System"</strong>, an automated hardware material management and intelligence system.</li>
                <li>Spearheaded full-stack development for Generative AI Agent web applications utilizing React.js, FastAPI, and LangGraph multi-agent orchestration.</li>
                <li>Architected and managed containerized GPU clusters for AI workloads, optimizing compute density and vGPU allocation with <strong>NVIDIA GPU Operator and HAMi</strong>.</li>
                <li>Engineered custom QR code applications and high-throughput asynchronous message queues via RabbitMQ.</li>
              </ul>
              <div class="entry-stack">
                <span class="stack-label">STACK:</span> React.js, FastAPI, LangGraph, SQL Server, PostgreSQL, RabbitMQ, IIS, HAMi, GPU Operator, Longhorn
              </div>
            </div>
          </article>
        </div>

        <!-- 02: NICS -->
        <div class="chamfer-card-wrapper timeline-wrapper">
          <article class="chamfer-card-content timeline-inner">
            <div class="entry-meta">
              <span class="card-tag">NODE // NATIONAL CYBER SECURITY</span>
              <span class="entry-period">MAR 2025 – NOV 2025 (9 MOS)</span>
              <span class="entry-company">National Institute of Cyber Security (NICS)</span>
              <span class="entry-location">Zhongzheng Dist., Taipei</span>
              <span class="entry-role">
                <span class="chamfer-inner">Software Engineer</span>
              </span>
            </div>
            <div class="entry-content">
              <ul class="entry-bullets">
                <li>Drove cloud security initiatives and contributed directly to the development of the <strong>AWS Government Configuration Baseline</strong> for national infrastructure.</li>
                <li>Researched and implemented cutting-edge AI features and autonomous workflows using LangGraph and Multi-Agent LLMs.</li>
                <li>Constructed secure serverless and containerized APIs with Next.js, FastAPI, and MongoDB backend storage.</li>
              </ul>
              <div class="entry-stack">
                <span class="stack-label">STACK:</span> Python, Next.js, LangGraph, FastAPI, CloudFormation, MongoDB, AWS Security Baselines
              </div>
            </div>
          </article>
        </div>

        <!-- 03: Cloud Service Provider -->
        <div class="chamfer-card-wrapper timeline-wrapper">
          <article class="chamfer-card-content timeline-inner">
            <div class="entry-meta">
              <span class="card-tag">NODE // CLOUD ARCHITECTURE</span>
              <span class="entry-period">JUN 2024 – MAR 2025 (10 MOS)</span>
              <span class="entry-company">Cloud Service Provider (Agency)</span>
              <span class="entry-location">Nangang Dist., Taipei</span>
              <span class="entry-role">
                <span class="chamfer-inner">Project Engineer / Software Engineer</span>
              </span>
            </div>
            <div class="entry-content">
              <ul class="entry-bullets">
                <li>Architected and implemented enterprise GCP and AWS cloud environments, executed complex cross-cloud migrations, and configured secure site-to-site VPNs.</li>
                <li>Designed centralized monitoring platforms and deployed production Kubernetes clusters with fine-grained RBAC security policies.</li>
                <li>Managed network topology planning and security perimeters: WAF, Firewalls, Load Balancers, and VPC peering.</li>
                <li>Authored automated Infrastructure as Code (IaC) with Terraform and resolved mission-critical infrastructure incidents.</li>
              </ul>
              <div class="entry-stack">
                <span class="stack-label">STACK:</span> Kubernetes, GCP, AWS, Terraform, Ansible, WAF, Cloud Architecture
              </div>
            </div>
          </article>
        </div>

        <!-- 04: CSIE InfoSec Lab -->
        <div class="chamfer-card-wrapper timeline-wrapper">
          <article class="chamfer-card-content timeline-inner">
            <div class="entry-meta">
              <span class="card-tag">NODE // RESEARCH &amp; THESIS</span>
              <span class="entry-period">SEP 2021 – OCT 2023 (2 YRS 2 MOS)</span>
              <span class="entry-company">Information Security Lab, NCYU CSIE</span>
              <span class="entry-location">Chiayi City, Taiwan</span>
              <span class="entry-role">
                <span class="chamfer-inner">Master's Researcher &amp; Project Assistant</span>
              </span>
            </div>
            <div class="entry-content">
              <ul class="entry-bullets">
                <li>Conducted advanced research in deep learning and cybersecurity intrusion detection for web application security.</li>
                <li>Designed a novel hybrid architecture combining Multi-Model CNN, Bidirectional GRU, and Multi-Head Self-Attention for SQLi and XSS attack detection.</li>
                <li>Published peer-reviewed master's thesis research in IEEE Xplore (Doc: 10210155).</li>
                <li>Developed machine learning pipelines and research demonstration web platforms with Python, Django, Flask, PyTorch, and TensorFlow.</li>
              </ul>
              <div class="entry-stack">
                <span class="stack-label">STACK:</span> Python, PyTorch, TensorFlow, Django, Flask, Deep Learning, IEEE Publication
              </div>
            </div>
          </article>
        </div>

        <!-- 05: Ticrown Asset Management -->
        <div class="chamfer-card-wrapper timeline-wrapper">
          <article class="chamfer-card-content timeline-inner">
            <div class="entry-meta">
              <span class="card-tag">NODE // EARLY CAREER</span>
              <span class="entry-period">DEC 2019 – MAR 2020 (4 MOS)</span>
              <span class="entry-company">Ticrown Asset Management Ltd.</span>
              <span class="entry-location">Daliao Dist., Kaohsiung City</span>
              <span class="entry-role">
                <span class="chamfer-inner">PHP Assistant Engineer / Web Designer</span>
              </span>
            </div>
            <div class="entry-content">
              <ul class="entry-bullets">
                <li>Collaborated on the development and UI implementation of a PHP Laravel-based logistics management system for a shipping container enterprise.</li>
                <li>Designed database schemas and responsive web views before transitioning to graduate studies in computer science.</li>
              </ul>
              <div class="entry-stack">
                <span class="stack-label">STACK:</span> PHP, Laravel, MySQL, JavaScript, CSS
              </div>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- ════════ CONTACT DISPATCH TERMINAL ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">// 04 · DISPATCH &amp; CONTACT</span>
        <h2 class="head-title">Direct Communication Channel &amp; Availability</h2>
      </div>

      <div class="chamfer-card-wrapper dispatch-wrapper">
        <div class="chamfer-card-content dispatch-inner">
          <div class="dispatch-header-bar">
            <div class="card-tag">TERMINAL // GLOBAL TELEMETRY &amp; DISPATCH NODE</div>
            <div class="node-telemetry-tag">LOC: 25.0330° N, 121.5654° E · UTC+8 · [DRAG &amp; ZOOM ENABLED]</div>
          </div>

          <!-- World Map Telemetry Canvas -->
          <div class="dispatch-map-frame">
            <div id="dispatch-world-map" class="dispatch-world-map" data-world-url={`${baseUrl}/geojson/world.json`}></div>
          </div>

          <!-- Minimal English Location Note -->
          <div class="dispatch-location-brief">
            <div class="loc-indicator">
              <span class="loc-dot"></span>
              <span class="loc-node-title">PRIMARY NODE // TAIPEI, TAIWAN</span>
            </div>
            <p class="loc-summary-text">
              Stationed in <strong>Taipei, Taiwan (UTC+8)</strong>. Available for on-site &amp; hybrid engineering roles in Taipei, and worldwide remote collaboration across distributed teams.
            </p>
          </div>

          <div class="dispatch-divider"></div>

          <div class="dispatch-grid">
            <div class="dispatch-info">
              <div class="term-line"><span class="term-k">&gt; CANDIDATE:</span> <span class="term-v">Alex.Hsiao (Wei-Chun Hsiao)</span></div>
              <div class="term-line"><span class="term-k">&gt; LOCATION:</span> <span class="term-v">Taipei, Taiwan (UTC+8 · CST)</span></div>
              <div class="term-line"><span class="term-k">&gt; WORK MODE:</span> <span class="term-v">Taipei Hybrid / On-Site &amp; Global Remote</span></div>
              <div class="term-line"><span class="term-k">&gt; STATUS:</span> <span class="term-v">ONLINE // OPEN FOR SENIOR ROLES</span></div>
              <div class="term-line"><span class="term-k">&gt; EMAIL:</span> <span class="term-v">q123717111@gmail.com</span></div>
              <div class="term-line"><span class="term-k">&gt; PHONE:</span> <span class="term-v">+886 0970-565-709</span></div>
            </div>

            <div class="dispatch-actions">
              <a href="mailto:q123717111@gmail.com" class="mono-btn-chamfer btn-block">
                <span class="chamfer-inner">
                  <span class="btn-tag">MAIL //</span>
                  <span class="btn-label">Send Direct Email &rarr;</span>
                </span>
              </a>
              <button class="mono-btn-chamfer btn-block" onclick="navigator.clipboard.writeText('q123717111@gmail.com'); showToast('Email copied to clipboard!');">
                <span class="chamfer-inner">
                  <span class="btn-tag">COPY //</span>
                  <span class="btn-label">q123717111@gmail.com</span>
                </span>
              </button>
              <button class="mono-btn-chamfer btn-block" onclick="navigator.clipboard.writeText('0970-565-709'); showToast('Phone copied to clipboard!');">
                <span class="chamfer-inner">
                  <span class="btn-tag">PHONE //</span>
                  <span class="btn-label">+886 0970-565-709</span>
                </span>
              </button>
            </div>
          </div>

          <div class="dispatch-src-line">
            GEOJSON 1:110M · ECHARTS MONO TELEMETRY · TAIPEI UTC+8 NODE
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 1040px;
  }

  /* ── Borderless Editorial Card Architecture (Native Ground & Hairline Dividers) ── */
  .cert-card-wrapper,
  .cert-card-inner,
  .skill-group-wrapper,
  .skill-group-inner,
  .timeline-wrapper,
  .timeline-inner,
  .dispatch-wrapper,
  .dispatch-inner {
    clip-path: none;
  }

  .cert-card-wrapper,
  .skill-group-wrapper,
  .timeline-wrapper {
    background-color: transparent;
    padding: 0;
    width: 100%;
    border-bottom: 0.7px solid var(--mono-grid);
    transition: none;
  }

  .dispatch-wrapper {
    background-color: transparent;
