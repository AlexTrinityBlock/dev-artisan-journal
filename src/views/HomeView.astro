---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCV } from '../data/cv';
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = getCV(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Strings consumed by the inline ECharts script (define:vars).
const mapTooltip = data.dispatch.mapTooltip;
const mapSub = data.dispatch.mapSub;
// Index 2 of the terminal ledger is the WORK MODE row.
const mapMode = data.dispatch.term[2].v;
const mapLabel = data.dispatch.mapLabel;
---

<BaseLayout
  lang={lang}
  title={data.seo.title}
  description={data.seo.description}
>
  <div class="container about-container">
    
    <!-- ════════ TOP HERO PROFILE (BORDERLESS EDITORIAL DESIGN) ════════ -->
    <section class="profile-hero-borderless">
      
      <!-- Top Section Header -->
      <div class="profile-meta-top">
        <span class="card-tag">{data.hero.tag}</span>
        <span class="role-pill">
          <span class="chamfer-inner">{data.hero.role}</span>
        </span>
      </div>

      <div class="profile-hero-layout">
        
        <div class="profile-avatar-block">
          <div class="avatar-frame">
            <img
              class="avatar-large"
              src={`${baseUrl}/images/avatar/avatar.jpg`}
              alt="Alex.Hsiao (Wei-Chun Hsiao) — FullStack & GenAI Systems Architect"
              loading="lazy"
            />
          </div>
          <div class="status-indicator-badge">
            <span class="chamfer-inner">
              <span class="status-dot"></span>
              <span>{data.hero.status}</span>
            </span>
          </div>
        </div>

        <div class="profile-hero-content">
          <h1 class="profile-name">{data.hero.name} <span class="profile-alias">{data.hero.alias}</span></h1>
          
          <p class="profile-intro-lead" set:html={data.hero.intro} />

          <div class="profile-quick-ledger">
            {data.hero.ledger.map((item) => (
              <div class="ledger-item">
                <span class="ledger-k">{item.k}</span>
                <span class="ledger-v">{item.v}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
      
      <div class="hero-divider"></div>
    </section>

    <!-- ════════ VERIFIED CERTIFICATIONS & PUBLICATIONS ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">{data.sections.certs.tag}</span>
        <h2 class="head-title">{data.sections.certs.title}</h2>
        {data.sections.certs.desc && <p class="head-desc">{data.sections.certs.desc}</p>}
      </div>

      <div class="certs-list">
        {data.certs.map((cert) => (
          <div class="chamfer-card-wrapper cert-card-wrapper">
            <div class="chamfer-card-content cert-card-inner">
              
              <!-- Left Column: 240px Left Rail (Portrait / Framed Certificate Exhibit) -->
              <div class="cert-portrait-rail">
                <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-portrait-frame" title={cert.title}>
                  <img src={`${baseUrl}${cert.image}`} alt={cert.title} loading="lazy" class="cert-portrait-img" />
                </a>
                <span class="cert-portrait-caption">{cert.meta}</span>
              </div>

              <!-- Right Column: 1fr (Comprehensive Credential Specification & Explanation) -->
              <div class="cert-right-content">
                <div class="cert-meta-header">
                  <span class="card-tag">{cert.tag}</span>
                  <span class="cert-issuer-badge">{cert.issuer}</span>
                </div>

                <h3 class="cert-name-text">
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-title-link">
                    {cert.title}
                  </a>
                </h3>

                <p class="cert-desc-text">{cert.description}</p>

                <div class="cert-footer-rail">
                  <div class="cert-id-badge">
                    <span class="cert-id-k">{t.cv.certId}</span>
                    <span class="cert-id-v">{cert.id}</span>
                  </div>
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="mono-btn-chamfer cert-verify-btn">
                    <span class="chamfer-inner">
                      <span class="btn-tag">VERIFY //</span>
                      <span class="btn-label">{t.cv.verify} [↗]</span>
                    </span>
                  </a>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════ TECHNICAL SKILLS MATRIX ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">{data.sections.skills.tag}</span>
        <h2 class="head-title head-title-icon">
          <svg class="head-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg>
          <span>{data.sections.skills.title}</span>
        </h2>
      </div>

      <div class="skills-category-list">
        {data.skillGroups.map((group) => (
          <div class="chamfer-card-wrapper skill-group-wrapper">
            <div class="chamfer-card-content skill-group-inner">
              
              <!-- Left Column: 240px Left Rail (Skills & Proficiency) -->
              <div class="group-left-rail">
                <div class="group-header">
                  <span class="card-tag">{group.tag}</span>
                  <h3 class="group-title">{group.title}</h3>
                </div>
                <div class="group-skills-stack">
                  {group.skills.map((skill) => (
                    <div class="skill-row">
                      <span class="skill-name">{skill.name}</span>
                      <span class="skill-level">{skill.level}</span>
                    </div>
                  ))}
                </div>
              </div>

              <!-- Right Column: 1fr (Integrated Production Architecture Narrative) -->
              <div class="group-right-content">
                <div class="group-synopsis-head">
                  <span class="synopsis-label">{t.cv.synopsis}</span>
                </div>
                <p class="group-synopsis-text">{group.synopsis}</p>
                <div class="group-stack-footer">
                  <span class="stack-footer-label">{t.cv.stack}</span> {group.stack}
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════ WORK EXPERIENCE CHRONICLE ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">{data.sections.timeline.tag}</span>
        <h2 class="head-title head-title-icon">
          <svg class="head-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/></svg>
          <span>{data.sections.timeline.title}</span>
        </h2>
      </div>

      <div class="timeline-list">
        {data.timeline.map((entry) => (
          <div class="chamfer-card-wrapper timeline-wrapper">
            <article class="chamfer-card-content timeline-inner">
              <div class="entry-meta">
                <span class="card-tag">{entry.tag}</span>
                <span class="entry-period">{entry.period}</span>
                <span class="entry-company">{entry.company}</span>
                <span class="entry-location">{entry.location}</span>
                <span class="entry-role">
                  <span class="chamfer-inner">{entry.role}</span>
                </span>
              </div>
              <div class="entry-content">
                <ul class="entry-bullets">
                  {entry.bullets.map((bullet) => (
                    <li set:html={bullet} />
                  ))}
                </ul>
                {entry.stack && (
                  <div class="entry-stack">
                    <span class="stack-label">{t.cv.stackShort}</span> {entry.stack}
                  </div>
                )}
              </div>
            </article>
          </div>
        ))}
      </div>
    </section>

    <!-- ════════ CONTACT DISPATCH TERMINAL ════════ -->
    <section class="section-block">
      <div class="section-head">
        <span class="head-tag">{data.sections.dispatch.tag}</span>
        <h2 class="head-title">{data.sections.dispatch.title}</h2>
      </div>

      <div class="chamfer-card-wrapper dispatch-wrapper">
        <div class="chamfer-card-content dispatch-inner">
          <div class="dispatch-header-bar">
            <div class="card-tag">{data.dispatch.tag}</div>
            <div class="node-telemetry-tag">{data.dispatch.telemetry}</div>
          </div>

          <!-- World Map Telemetry Canvas -->
          <div class="dispatch-map-frame">
            <div id="dispatch-world-map" class="dispatch-world-map" data-world-url={`${baseUrl}/geojson/world.json`}></div>
          </div>

          <!-- Minimal Location Note -->
          <div class="dispatch-location-brief">
            <div class="loc-indicator">
              <span class="loc-dot"></span>
              <span class="loc-node-title">{data.dispatch.locationTitle}</span>
            </div>
            <p class="loc-summary-text" set:html={data.dispatch.locationText} />
          </div>

          <div class="dispatch-divider"></div>

          <div class="dispatch-grid">
            <div class="dispatch-info">
              {data.dispatch.term.map((line) => (
                <div class="term-line"><span class="term-k">{line.k}</span> <span class="term-v">{line.v}</span></div>
              ))}
            </div>

            <div class="dispatch-actions">
              <a href="mailto:q123717111@gmail.com" class="mono-btn-chamfer btn-block">
                <span class="chamfer-inner">
                  <span class="btn-tag">MAIL //</span>
                  <span class="btn-label">{data.dispatch.mail} &rarr;</span>
                </span>
              </a>
              <button class="mono-btn-chamfer btn-block" onclick={`navigator.clipboard.writeText('q123717111@gmail.com'); showToast('${t.toast.emailCopied}');`}>
                <span class="chamfer-inner">
                  <span class="btn-tag">COPY //</span>
                  <span class="btn-label">q123717111@gmail.com</span>
                </span>
              </button>
              <button class="mono-btn-chamfer btn-block" onclick={`navigator.clipboard.writeText('0970-565-709'); showToast('${t.toast.phoneCopied}');`}>
                <span class="chamfer-inner">
                  <span class="btn-tag">PHONE //</span>
                  <span class="btn-label">+886 0970-565-709</span>
                </span>
              </button>
            </div>
          </div>

          <div class="dispatch-src-line">{data.dispatch.src}</div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>


<style>
  .about-container {
    max-width: 1040px;
  }

  /* ── Borderless Editorial Card Architecture (Native Ground & Hairline Dividers) ── */
  .cert-card-wrapper,
  .cert-card-inner,
  .skill-group-wrapper,
  .skill-group-inner,
  .timeline-wrapper,
  .timeline-inner,
  .dispatch-wrapper,
  .dispatch-inner {
    clip-path: none;
  }

  .cert-card-wrapper,
  .skill-group-wrapper,
  .timeline-wrapper {
    background-color: transparent;
    padding: 0;
    width: 100%;
    border-bottom: 0.7px solid var(--mono-grid);
    transition: none;
  }

  .dispatch-wrapper {
    background-color: transparent;
    padding: 0;
    width: 100%;
    border-top: 0.7px solid var(--mono-grid);
    border-bottom: 0.7px solid var(--mono-grid);
  }

  .cert-card-inner,
  .skill-group-inner,
  .timeline-inner {
    background-color: transparent;
    color: var(--mono-ink);
    padding: 32px 0;
  }

  .dispatch-inner {
    background-color: transparent;
    color: var(--mono-ink);
    padding: 28px 0;
  }

  /* ── Borderless Hero Profile (SYSTEM // 01 · CANDIDATE PROFILE) ── */
  .profile-hero-borderless {
    margin-bottom: 56px;
    padding-top: 12px;
  }

  .profile-meta-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 0.7px solid var(--mono-grid);
    flex-wrap: wrap;
  }

  .profile-hero-layout {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  .profile-avatar-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 216px;
    flex-shrink: 0;
  }

  .avatar-frame {
    position: relative;
    width: 216px;
    height: 216px;
  }

  .avatar-large {
    width: 216px;
    height: 216px;
    border-radius: 0;
    object-fit: cover;
    display: block;
    border: 0.7px solid var(--mono-grid);
    background: var(--mono-bg-subtle);
  }

  .status-indicator-badge {
    display: inline-flex;
    padding: 0.7px;
    background-color: var(--mono-grid);
    clip-path: polygon(
      0 0,
      calc(100% - 6px) 0,
      100% 6px,
      100% 100%,
      6px 100%,
      0 calc(100% - 6px)
    );
    width: 100%;
  }

  .status-indicator-badge .chamfer-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: 100%;
    font-family: var(--mono-font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--mono-l2);
    background: var(--mono-paper);
    padding: 5px 12px;
    clip-path: polygon(
      0 0,
      calc(100% - 6px) 0,
      100% 6px,
      100% 100%,
      6px 100%,
      0 calc(100% - 6px)
    );
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #2e7d32;
    display: inline-block;
  }

  .profile-hero-content {
    flex-grow: 1;
    min-width: 0;
  }

  .role-pill {
    display: inline-flex;
    padding: 0.7px;
    background-color: var(--mono-grid);
    clip-path: polygon(
      0 0,
      calc(100% - 6px) 0,
      100% 6px,
      100% 100%,
      6px 100%,
      0 calc(100% - 6px)
    );
  }

  .role-pill .chamfer-inner {
    display: inline-flex;
    align-items: center;
    font-family: var(--mono-font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--mono-ink);
    background: var(--mono-paper);
    padding: 3px 9px;
    clip-path: polygon(
      0 0,
      calc(100% - 6px) 0,
      100% 6px,
      100% 100%,
      6px 100%,
      0 calc(100% - 6px)
    );
    letter-spacing: 0.06em;
  }

  .profile-name {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--mono-ink);
    letter-spacing: -0.03em;
    margin: 0 0 14px 0;
    line-height: 1.15;
  }

  .profile-alias {
    font-size: 1.65rem;
    color: var(--mono-muted);
    font-weight: 500;
  }

  .profile-intro-lead {
    font-size: 15px;
    line-height: 1.75;
    color: var(--mono-l2);
    margin: 0 0 26px 0;
    max-width: 820px;
  }

  /* Borderless Quick Ledger Grid */
  .profile-quick-ledger {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 28px;
  }

  /* Keep an odd ledger count from leaving a lopsided gap. */
  .profile-quick-ledger > .ledger-item:last-child:nth-child(odd) {
    grid-column: span 2;
  }

  .ledger-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 0.7px solid var(--mono-grid);
    padding-top: 10px;
  }

  .ledger-k {
    font-family: var(--mono-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--mono-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ledger-v {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--mono-ink);
    line-height: 1.4;
  }

  .hero-divider {
    margin-top: 48px;
    border-bottom: 0.7px solid var(--mono-grid);
  }

  /* ── Section Blocks ────────────────────────────────────────── */
  .section-block {
    margin-bottom: 56px;
  }

  .section-head {
    margin-bottom: 24px;
  }

  .head-tag {
    font-family: var(--mono-font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--mono-muted);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 6px;
  }

  .head-title {
    font-size: 1.55rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--mono-ink);
    margin: 0 0 6px 0;
  }

  /* Lucide glyph rail for section heads that carry one. */
  .head-title-icon {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .head-icon {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--mono-muted);
  }

  .head-desc {
    font-size: 13.5px;
    color: var(--mono-muted);
    margin: 0;
  }

  /* ── Verified Credentials List (2-Column Split: Portrait Left / Specs Right) ── */
  .certs-list {
    display: flex;
    flex-direction: column;
    border-top: 0.7px solid var(--mono-grid);
    gap: 0;
  }

  .cert-card-wrapper {
    display: flex;
    width: 100%;
  }

  .cert-card-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 36px;
    padding: 32px 0;
    width: 100%;
    min-height: 290px;
  }

  .cert-portrait-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cert-portrait-frame {
    width: 100%;
    height: 240px;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    text-decoration: none;
  }

  .cert-card-wrapper:hover .cert-portrait-frame {
    opacity: 0.92;
  }

  .cert-portrait-img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  .cert-portrait-caption {
    font-family: var(--mono-font-mono);
    font-size: 9.5px;
    color: var(--mono-muted);
    margin-top: 10px;
    text-align: center;
    display: block;
    line-height: 1.35;
  }

  .cert-right-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .cert-meta-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .cert-meta-header .card-tag {
    margin-bottom: 0;
    font-size: 10px;
  }

  .cert-issuer-badge {
    font-family: var(--mono-font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--mono-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cert-name-text {
    font-size: 16.5px;
    font-weight: 800;
    color: var(--mono-ink);
    line-height: 1.3;
    margin: 0 0 12px 0;
    letter-spacing: -0.015em;
  }

  .cert-title-link {
    color: var(--mono-ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cert-title-link:hover {
    color: var(--mono-l2);
  }

  .cert-desc-text {
    font-size: 14px;
    line-height: 1.75;
    color: var(--mono-l2);
    margin: 0 0 20px 0;
  }

  .cert-footer-rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border-top: 0.7px dashed var(--mono-grid);
    flex-wrap: wrap;
  }

  .cert-id-badge {
    font-family: var(--mono-font-mono);
    font-size: 10px;
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .cert-id-k {
    color: var(--mono-muted);
    font-weight: 600;
  }

  .cert-id-v {
    color: var(--mono-ink);
    font-weight: 700;
  }

  /* ── Skills Category List (2-Column Split: Skills Left / Synopsis Right) ── */
  .skills-category-list {
    display: flex;
    flex-direction: column;
    border-top: 0.7px solid var(--mono-grid);
    gap: 0;
  }

  .skill-group-inner {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 36px;
    padding: 32px 0;
    min-height: 250px;
  }

  .group-left-rail {
    display: flex;
    flex-direction: column;
  }

  .group-header {
    margin-bottom: 14px;
  }

  .group-header .card-tag {
    display: block;
    margin-bottom: 4px;
    font-size: 10px;
  }

  .group-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--mono-ink);
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
  }

  .group-skills-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .skill-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12.5px;
    padding-bottom: 6px;
    border-bottom: 0.7px dashed var(--mono-grid);
  }

  .skill-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .skill-name {
    font-weight: 600;
    color: var(--mono-ink);
  }

  .skill-level {
    font-family: var(--mono-font-mono);
    font-size: 9.5px;
    color: var(--mono-muted);
    font-weight: 700;
  }

  .group-right-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .group-synopsis-head {
