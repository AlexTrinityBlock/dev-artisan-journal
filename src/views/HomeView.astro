<!-- ECharts Local Script & Telemetry Map Renderer -->
<script is:inline src={`${baseUrl}/js/echarts.min.js`}></script>
<script is:inline define:vars={{ mapTooltip, mapSub, mapMode, mapLabel }}>
  (function() {
    var INK = '#1C1C1A', PAPER = '#F0EFEB', MUTED = '#8F8E88', GRID = '#DEDDD6';

    var obsReveal = function(id, fn) {
      var n = document.getElementById(id);
      if (!n) return;
      var rendered = false;
      var go = function() {
        if (rendered) return;
        rendered = true;
        fn(n);
      };

      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(es) {
          if (es[0].isIntersecting) {
            go();
            io.disconnect();
          }
        }, { threshold: 0.1 });
        io.observe(n);
      }
      // Safety fallback: render anyway if not triggered after 400ms
      setTimeout(go, 400);
    };

    var mapEl = document.getElementById('dispatch-world-map');
    var worldUrl = (mapEl && mapEl.dataset.worldUrl) || '/geojson/world.json';

    fetch(worldUrl)
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP error ' + r.status);
        return r.json();
      })
      .then(function(geo) {
        echarts.registerMap('mono-world', geo);
        var opt = {
          animationDuration: 900,
          animationEasing: 'quarticOut',
          tooltip: {
            backgroundColor: INK,
            borderWidth: 0,
            padding: [10, 14],
            textStyle: {
              color: PAPER,
              fontFamily: 'Inter, JetBrains Mono, sans-serif',
              fontSize: 12
            },
            formatter: function(p) {
              if (p.name === 'Taiwan') {
                return '<span style="font-weight:700;letter-spacing:0.05em;">' + mapTooltip + '</span><br/><span style="color:#C6C5BF;font-size:10px;">' + mapSub + '</span><br/><span style="color:#D8D7D1;font-size:10px;">' + mapMode + '</span>';
              }
              return (p.name || 'Territory');
            }
          },
          series: [{
            type: 'map',
            map: 'mono-world',
            top: 'middle',
            left: 'center',
            center: [121.5, 24.0],
            zoom: 3.8,
            roam: true,
            scaleLimit: {
              min: 1.0,
              max: 15.0
            },
            itemStyle: {
              areaColor: '#E4E3DC',
              borderColor: PAPER,
              borderWidth: 0.7
            },
            emphasis: {
              label: {
                show: true,
                fontFamily: 'Inter, sans-serif',
                fontSize: 10,
                fontWeight: 800,
                color: INK,
                textBorderColor: PAPER,
                textBorderWidth: 3
              },
              itemStyle: {
                areaColor: '#D8D7D1',
                borderColor: INK,
                borderWidth: 1.1
              }
            },
            select: { disabled: true },
            data: [
              {
                name: 'Taiwan',
                itemStyle: {
                  areaColor: INK,
                  borderColor: INK,
                  borderWidth: 1.2
                },
                emphasis: {
                  itemStyle: {
                    areaColor: '#000000',
                    borderColor: INK,
                    borderWidth: 1.5
                  }
                },
                label: {
                  show: true,
                  formatter: mapLabel,
                  offset: [76, -4],
                  fontFamily: 'JetBrains Mono, Inter, monospace',
                  fontSize: 9.5,
                  fontWeight: 800,
                  color: INK,
                  textBorderColor: PAPER,
                  textBorderWidth: 3
                }
              }
            ]
          }]
        };

        obsReveal('dispatch-world-map', function(elDom) {
          var g = echarts.getInstanceByDom(elDom) || echarts.init(elDom);
          g.clear();
          g.setOption(opt);
        });

        window.addEventListener('resize', function() {
          echarts.getInstanceByDom(document.getElementById('dispatch-world-map'))?.resize();
        });
      })
      .catch(function(err) {
        console.error('Map loading error:', err);
      });
  })();
</script>