---
import '../styles/tokens.css';
import { getCV } from '../data/cv';
import type { Lang } from '../i18n/config';
import { ICONS, entryIcon, skillIcon } from '../data/icons';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = getCV(lang);

const copy = {
  en: {
    kicker: 'DEV ARTISAN // CURRICULUM VITAE',
    continued: 'CURRICULUM VITAE // CONTINUED',
    updated: 'REV. 2026.10 · TAIPEI',
    experience: 'Experience',
    skills: 'Technical Skills',
    certs: 'Certifications & Publications',
    education: 'Education',
    stack: 'STACK',
    verify: 'verify',
    download: 'Download PDF',
    print: 'Print',
    educationLine: 'M.S. in Computer Science & Information Engineering — National Chiayi University',
    educationNote:
      "Master's thesis published in IEEE Xplore (Doc. 10210155): a hybrid CNN / BiGRU / multi-head attention architecture for SQLi and XSS detection.",
    footnote: 'Every credential links to its public verification page. References and availability on request.',
    location: 'Taipei, Taiwan · UTC+8',
  },
  'zh-hant': {
    kicker: 'DEV ARTISAN // 履歷',
    continued: '履歷 // 續頁',
    updated: '版本 2026.10 · 台北',
    experience: '工作經歷',
    skills: '技術能力',
    certs: '認證與論文',
    education: '學歷',
    stack: '技術棧',
    verify: '驗證',
    download: '下載 PDF',
    print: '列印',
    educationLine: '國立嘉義大學 資訊工程學系 碩士',
    educationNote: '碩士論文發表於 IEEE Xplore（文獻 10210155）：結合 CNN、BiGRU 與多頭自注意力之 SQLi／XSS 偵測架構。',
    footnote: '所有認證皆附公開驗證連結。推薦人與到職時間可於面談時提供。',
    location: '台北，台灣 · UTC+8',
  },
  'zh-hans': {
    kicker: 'DEV ARTISAN // 履历',
    continued: '履历 // 续页',
    updated: '版本 2026.10 · 台北',
    experience: '工作经历',
    skills: '技术能力',
    certs: '认证与论文',
    education: '学历',
    stack: '技术栈',
    verify: '验证',
    download: '下载 PDF',
    print: '打印',
    educationLine: '国立嘉义大学 信息工程学系 硕士',
    educationNote: '硕士论文发表于 IEEE Xplore（文献 10210155）：结合 CNN、BiGRU 与多头自注意力之 SQLi／XSS 检测架构。',
    footnote: '所有认证皆附公开验证链接。推荐人与到职时间可于面谈时提供。',
    location: '台北，台湾 · UTC+8',
  },
}[lang];

const email = data.dispatch.term.find((row) => row.v.includes('@'))?.v ?? '';
const phone = data.dispatch.term.find((row) => /^\+\d/.test(row.v))?.v ?? '';
const site = new URL(Astro.site ?? 'https://blog.alextrinitywolf.com').host;

// A CV stays readable at two pages; the site keeps the full bullet list.
const bulletLimit: Record<string, number> = {
  'NODE // CURRENT': 6,
  'NODE // ACADEMIC ADVISORY': 2,
  'NODE // NATIONAL CYBER SECURITY': 3,
  'NODE // CLOUD ARCHITECTURE': 3,
  'NODE // RESEARCH & THESIS': 2,
  'NODE // EARLY CAREER': 1,
};
const jobs = data.timeline.map((entry) => ({
  ...entry,
  shown: entry.bullets.slice(0, bulletLimit[entry.tag] ?? entry.bullets.length),
}));

// Fixed A4 blocks: the first page takes as many roles as fit, the rest flow
// onto page two next to skills, credentials and education.
const breakAt = ({ en: 4, 'zh-hant': 5, 'zh-hans': 5 } as Record<string, number>)[lang] ?? 4;
const pageOne = jobs.slice(0, breakAt);
const pageTwo = jobs.slice(breakAt);

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Static single-weight faces: Chrome prints variable fonts as Type3 glyph
// procedures, which most ATS parsers cannot read back.
const fontFace = (family: string, weight: number, file: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-weight:${weight};font-display:block;src:url('${baseUrl}/fonts/cv/${file}') format('woff2');}`;
const fontFaces = [
  ...[400, 500, 600, 700, 800].map((w) => fontFace('Inter', w, `inter-${w}.woff2`)),
  ...[400, 500, 600, 700].map((w) => fontFace('JetBrains Mono', w, `jetbrains-mono-${w}.woff2`)),
].join('\n');

const pdfHref = `${baseUrl}/cv/alex-hsiao-cv-${lang}.pdf`;
const langHref = (locale: Lang) => (locale === 'en' ? '/cv/' : `/${locale}/cv/`);

const icons = {
  route:
    '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>',
  layers:
    '<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>',
  badge:
    '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>',
  cap:
    '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${data.hero.name} — CV`}</title>
    <meta name="robots" content="noindex" />
    <style is:inline set:html={fontFaces}></style>
    <style>
      :root {
        color-scheme: light;
        --sans: 'Inter', 'Noto Sans TC', 'Microsoft JhengHei', 'PingFang TC', sans-serif;
        --mono: 'JetBrains Mono', 'Noto Sans TC', 'Microsoft JhengHei', ui-monospace, monospace;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      body {
        font-family: var(--sans);
        font-size: 8.8pt;
        line-height: 1.45;
        color: var(--mono-ink);
        background: var(--mono-bg-subtle);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      @page {
        size: A4;
        margin: 0;
      }

      /* One sheet = one printed page, paper tone edge to edge. */
      .page {
        width: 210mm;
        height: 296.8mm;
        padding: 14mm 14mm 12mm;
        background: var(--mono-paper);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      @media screen {
        body {
          padding: 28px 16px 60px;
        }

        .page {
          margin: 0 auto 24px;
          box-shadow: 0 12px 40px rgba(28, 28, 26, 0.1);
        }
      }

      @media print {
        body {
          background: none;
        }

        .page {
          margin: 0;
          box-shadow: none;
          break-after: page;
        }

        .page:last-of-type {
          break-after: auto;
        }
      }

      /* ── Screen-only toolbar ─────────────────────────────────── */
      .toolbar {
        position: fixed;
        right: 20px;
        bottom: 20px;
        display: flex;
        gap: 8px;
        align-items: center;
        padding: 8px;
        background: var(--mono-paper);
        border: 0.7px solid var(--mono-grid);
        box-shadow: 0 8px 24px rgba(28, 28, 26, 0.08);
        z-index: 20;
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.06em;
      }

      .toolbar a,
      .toolbar button {
        font: inherit;
        color: var(--mono-ink);
        background: transparent;
        border: 0.7px solid var(--mono-grid);
        padding: 6px 10px;
        cursor: pointer;
      }

      .toolbar a:hover,
      .toolbar button:hover {
        background: var(--mono-ink);
        color: var(--mono-paper);
        border-color: var(--mono-ink);
      }

      .toolbar .lang {
        display: flex;
        gap: 4px;
        padding-left: 4px;
      }

      .toolbar .lang a[aria-current='true'] {
        background: var(--mono-ink);
        color: var(--mono-paper);
        border-color: var(--mono-ink);
      }

      @media print {
        .toolbar {
          display: none !important;
        }
      }

      /* ── Masthead ────────────────────────────────────────────── */
      .strip {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-family: var(--mono);
        font-size: 6.8pt;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--mono-muted);
        padding-bottom: 3.4mm;
        border-bottom: 0.7px solid var(--mono-ink);
      }

      h1 {
        margin-top: 4.6mm;
        font-size: 24pt;
        font-weight: 800;
        letter-spacing: -0.035em;
        line-height: 1.02;
      }

      h1 .alias {
        font-size: 11pt;
        font-weight: 400;
        letter-spacing: 0;
        color: var(--mono-muted);
      }

      .role {
        margin-top: 2mm;
        font-family: var(--mono);
        font-size: 7.8pt;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }

      .intro {
        margin-top: 3.2mm;
        max-width: 152mm;
        font-size: 8.9pt;
        line-height: 1.5;
        color: var(--mono-l2);
      }

      .contact {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2mm 6mm;
        margin-top: 4.4mm;
        padding-top: 2.4mm;
        border-top: 0.7px solid var(--mono-grid);
      }

      .contact div {
        font-size: 8.2pt;
        font-weight: 600;
      }

      .contact span {
        display: block;
        font-family: var(--mono);
        font-size: 6.2pt;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: var(--mono-muted);
        margin-bottom: 0.4mm;
      }

      /* ── Sections ────────────────────────────────────────────── */
      section {
        margin-top: 5.4mm;
      }

      h2 {
        display: flex;
        align-items: center;
        gap: 2.2mm;
        padding-bottom: 1.5mm;
        margin-bottom: 0.4mm;
        border-bottom: 0.7px solid var(--mono-ink);
        font-size: 9pt;
        font-weight: 800;
        letter-spacing: 0.02em;
        break-after: avoid;
      }

      h2 svg {
        width: 3.4mm;
        height: 3.4mm;
        color: var(--mono-muted);
        flex: none;
      }

      /* ── Experience ──────────────────────────────────────────── */
      .job {
        display: grid;
        grid-template-columns: 38mm 1fr;
        gap: 6mm;
        padding: 2.5mm 0;
        border-bottom: 0.7px solid var(--mono-grid);
        break-inside: avoid;
      }

      .job:last-of-type {
        border-bottom: none;
      }

      .period {
        display: flex;
        align-items: center;
        gap: 1.4mm;
        font-family: var(--mono);
        font-size: 7.1pt;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .job-icon {
        width: 2.8mm;
        height: 2.8mm;
        flex: none;
        color: var(--mono-muted);
      }

      .company {
        margin-top: 0.8mm;
        font-size: 8.4pt;
        font-weight: 700;
        line-height: 1.3;
      }

      .title {
        margin-top: 0.6mm;
        font-size: 8pt;
        color: var(--mono-l3);
      }

      .place {
        margin-top: 0.6mm;
        font-family: var(--mono);
        font-size: 6.4pt;
        color: var(--mono-muted);
      }

      ul {
        list-style: none;
      }

      li {
        position: relative;
        padding-left: 3.4mm;
        margin-bottom: 1mm;
        font-size: 8.5pt;
        line-height: 1.45;
      }

      li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 1.45mm;
        width: 1.4mm;
        height: 1.4mm;
        background: var(--mono-l5);
      }

      li strong {
        font-weight: 700;
      }

      .stack {
        margin-top: 1.1mm;
        font-family: var(--mono);
        font-size: 6.6pt;
        line-height: 1.45;
        color: var(--mono-muted);
      }

      .stack b {
        color: var(--mono-ink);
        letter-spacing: 0.1em;
      }

      /* ── Skills / education rows ─────────────────────────────── */
      .row {
        display: grid;
        grid-template-columns: 38mm 1fr;
        gap: 6mm;
        padding: 2mm 0;
        border-bottom: 0.7px solid var(--mono-grid);
        break-inside: avoid;
      }

      .row:last-of-type {
        border-bottom: none;
      }

      .row dt {
        font-size: 8.2pt;
        font-weight: 700;
      }

      .row dd {
        font-size: 8.4pt;
        color: var(--mono-l2);
        line-height: 1.45;
      }

      /* Page two carries fewer blocks, so it gets a roomier rhythm. */
      .page:last-of-type section {
        margin-top: 5.5mm;
      }

      .page:last-of-type .row {
        padding: 2.5mm 0;
      }

      .page:last-of-type .cert {
        padding: 2.2mm 0;
      }

      /* ── Certifications ──────────────────────────────────────── */
      .certs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 6mm;
      }

      .cert {
        display: grid;
        grid-template-columns: 22mm 1fr;
        gap: 3mm;
        align-items: center;
        padding: 1.4mm 0;
        border-bottom: 0.7px solid var(--mono-grid);
        break-inside: avoid;
      }

      .cert-thumb {
        width: 100%;
        height: 12mm;
        object-fit: contain;
        border: 0.7px solid var(--mono-grid);
        background: #ffffff;
      }

      .skill {
        display: inline-flex;
        align-items: center;
        gap: 0.9mm;
      }

      .skill-icon {
        width: 2.7mm;
        height: 2.7mm;
        flex: none;
        color: var(--mono-muted);
      }

      .sep {
        color: var(--mono-faint);
        margin: 0 1.4mm;
      }

      .cert b {
        display: block;
        font-size: 8.1pt;
        font-weight: 700;
        line-height: 1.3;
      }

      .cert span {
        display: block;
        margin-top: 0.4mm;
        font-family: var(--mono);
        font-size: 6.2pt;
        letter-spacing: 0.03em;
        color: var(--mono-muted);
      }

      .cert a {
        color: var(--mono-l3);
        border-bottom: 0.5px solid var(--mono-faint);
      }

      .foot {
        margin-top: auto;
        padding-top: 2.6mm;
        border-top: 0.7px solid var(--mono-ink);
        font-family: var(--mono);
        font-size: 6.4pt;
        letter-spacing: 0.04em;
        color: var(--mono-muted);
        display: flex;
        justify-content: space-between;
        gap: 10mm;
      }
    </style>
  </head>

  <body>
    <div class="toolbar">
      <a href={pdfHref}>{copy.download}</a>
      <button onclick="window.print()">{copy.print}</button>
      <div class="lang">
        {(['en', 'zh-hant', 'zh-hans'] as Lang[]).map((locale) => (
          <a href={langHref(locale)} aria-current={locale === lang ? 'true' : 'false'}>
            {locale === 'en' ? 'EN' : locale === 'zh-hant' ? '繁' : '简'}
          </a>
        ))}
      </div>
    </div>

    <main>
      <article class="page">
        <div class="strip">
          <span>{copy.kicker}</span>
          <span>{copy.updated}</span>
        </div>

        <h1>{data.hero.name} <span class="alias">{data.hero.alias}</span></h1>
        <p class="role">{data.hero.role}</p>
        <p class="intro" set:html={data.hero.intro} />

        <div class="contact">
          <div><span>MAIL</span><a href={`mailto:${email}`}>{email}</a></div>
          <div><span>TEL</span><a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a></div>
          <div><span>LOC</span>{copy.location}</div>
          <div><span>WEB</span><a href={`https://${site}`}>{site}</a></div>
          <div><span>GITHUB</span><a href="https://github.com/AlexTrinityBlock">github.com/AlexTrinityBlock</a></div>
          <div><span>STATUS</span>{data.dispatch.term[3]?.v ?? ''}</div>
        </div>

        <section>
          <h2>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.route} />
            {copy.experience}
          </h2>
          {pageOne.map((job) => (
            <article class="job">
              <div>
                <div class="period">
                  <svg class="job-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[entryIcon(job.tag)]} />
                  {job.period}
                </div>
                <div class="company">{job.company}</div>
                <div class="title">{job.role}</div>
                <div class="place">{job.location}</div>
              </div>
              <div>
                <ul>
                  {job.shown.map((bullet) => (
                    <li set:html={bullet} />
                  ))}
                </ul>
                {job.stack && <div class="stack"><b>{copy.stack}</b> · {job.stack}</div>}
              </div>
            </article>
          ))}
        </section>

        <div class="foot">
          <span>{copy.footnote}</span>
          <span>01 / 02</span>
        </div>
      </article>

      <article class="page">
        <div class="strip">
          <span>{copy.continued}</span>
          <span>02 / 02</span>
        </div>

        <section>
          {pageTwo.map((job) => (
            <article class="job">
              <div>
                <div class="period">
                  <svg class="job-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[entryIcon(job.tag)]} />
                  {job.period}
                </div>
                <div class="company">{job.company}</div>
                <div class="title">{job.role}</div>
                <div class="place">{job.location}</div>
              </div>
              <div>
                <ul>
                  {job.shown.map((bullet) => (
                    <li set:html={bullet} />
                  ))}
                </ul>
                {job.stack && <div class="stack"><b>{copy.stack}</b> · {job.stack}</div>}
              </div>
            </article>
          ))}
        </section>

        <section>
          <h2>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.layers} />
            {copy.skills}
          </h2>
          {data.skillGroups.map((group) => (
            <dl class="row">
              <dt>{group.title}</dt>
              <dd>
                {group.skills.map((skill, i) => (
                  <>
                    <span class="skill">
                      <svg class="skill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[skillIcon(skill.name)]} />
                      {skill.name}
                    </span>
                    {i < group.skills.length - 1 && <span class="sep">·</span>}
                  </>
                ))}
              </dd>
            </dl>
          ))}
        </section>

        <section>
          <h2>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS['badge-check']} />
            {copy.certs}
          </h2>
          <div class="certs">
            {data.certs.map((cert) => (
              <div class="cert">
                <img
                  class="cert-thumb"
                  src={`${baseUrl}/cv/img/${(cert.image.split('/').pop() ?? '').replace(/\.png$/, '.jpg')}`}
                  alt=""
                  loading="lazy"
                />
                <div class="cert-body">
                  <b>{cert.title}</b>
                  <span>
                    {cert.issuer} · <a href={cert.url}>{copy.verify}</a>
                  </span>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS['graduation-cap']} />
            {copy.education}
          </h2>
          <dl class="row">
            <dt>{copy.educationLine}</dt>
            <dd>{copy.educationNote}</dd>
          </dl>
        </section>

        <div class="foot">
          <span>{copy.footnote}</span>
          <span>02 / 02</span>
        </div>
      </article>
    </main>
  </body>
</html>
