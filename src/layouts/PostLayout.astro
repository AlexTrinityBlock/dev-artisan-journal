---
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';

interface Props {
  post: {
    id: string;
    slug?: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      updatedDate?: Date;
      category: string;
      tags: string[];
      featured?: boolean;
      readTime?: string;
      author?: string;
    };
  };
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: any;
  nextPost?: any;
}

const { post, headings = [], prevPost, nextPost } = Astro.props;

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = post.data.updatedDate
  ? new Date(post.data.updatedDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${post.data.title} — DEV ARTISAN // JOURNAL`}
  description={post.data.description}
  article={true}
>
  <div class="container post-container">
    
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Articles</a>
      <span class="crumb-sep">/</span>
      <a href={`/tags/${post.data.category}`}>{post.data.category}</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">{post.data.title}</span>
    </nav>

    <!-- Post Article Header -->
    <header class="chamfer-card-wrapper post-header-wrapper">
      <div class="chamfer-card-content post-header-inner">
        <div class="post-meta-top">
          <span class="card-tag">{post.data.category}</span>
          <span class="meta-dot"></span>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
          <span class="meta-dot"></span>
          <span>{post.data.readTime || '5 min read'}</span>
        </div>

        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-subtitle">{post.data.description}</p>

        <div class="post-meta-bottom">
          <div class="author-inline">
            <img class="author-mini-avatar" src="/images/avatar/avatar.jpg" alt="Alex.Hsiao avatar" loading="lazy" />
            <div class="author-meta">
              <span class="author-name">{post.data.author || 'Alex.Hsiao'}</span>
              <span class="author-title">FullStack &amp; GenAI Architect · CKA &amp; ISO 27001 Auditor</span>
            </div>
          </div>

          <button class="mono-btn-chamfer share-btn" onclick="navigator.clipboard.writeText(window.location.href); showToast('Article URL copied to clipboard!');">
            <span class="chamfer-inner">
              <span class="btn-tag">SHARE //</span>
              <span class="btn-label">Copy Link</span>
            </span>
          </button>
        </div>
      </div>
    </header>

    <!-- Two-column Layout: Content + Sticky TOC -->
    <div class="post-content-layout">
      
      <!-- Main Prose Content -->
      <div class="chamfer-card-wrapper prose-wrapper">
        <article class="chamfer-card-content prose-inner">
          <slot />

          <!-- Article Tags & Share Row -->
          <div class="post-tags-row">
            <span class="tags-label">TOPICS:</span>
            <div class="tags-list">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${tag}`} class="tag">
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        </article>
      </div>

      <!-- Sidebar / Table of Contents -->
      {tocHeadings.length > 0 && (
        <aside class="post-sidebar">
          <div class="chamfer-card-wrapper toc-wrapper">
            <div class="chamfer-card-content toc-inner">
              <div class="toc-header">
                <span class="card-tag">SYSTEM // TOC</span>
              </div>
              <nav class="toc-nav">
                <ul>
                  {tocHeadings.map((h) => (
                    <li class={`toc-item depth-${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </div>
        </aside>
      )}

    </div>

    <!-- Post Bottom Navigation & Author Bio -->
    <div class="post-footer-section">
      <!-- Prev / Next navigation -->
      <div class="nav-adjacent-grid">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug || prevPost.id.replace(/\.[^/.]+$/, "")}`} class="chamfer-card-wrapper adjacent-wrapper interactive prev">
            <div class="chamfer-card-content adjacent-inner">
              <span class="adjacent-label">&larr; PREVIOUS ARTICLE</span>
              <span class="adjacent-title">{prevPost.data.title}</span>
            </div>
          </a>
        ) : <div />}

        {nextPost ? (
          <a href={`/blog/${nextPost.slug || nextPost.id.replace(/\.[^/.]+$/, "")}`} class="chamfer-card-wrapper adjacent-wrapper interactive next">
            <div class="chamfer-card-content adjacent-inner next-align">
              <span class="adjacent-label">NEXT ARTICLE &rarr;</span>
              <span class="adjacent-title">{nextPost.data.title}</span>
            </div>
          </a>
        ) : <div />}
      </div>

      <!-- Author Bio -->
      <div style="margin-top: 32px;">
        <AuthorBio />
      </div>

      <div class="back-home-wrap">
        <a href="/articles" class="mono-btn-chamfer">
          <span class="chamfer-inner">
            <span class="btn-tag">NAV //</span>
            <span class="btn-label">&larr; Back to All Articles</span>
          </span>
        </a>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .post-container {
    max-width: 1060px;
  }

  /* ── Dual-Chamfer Shared Geometry ──────────────────────────── */
  .post-header-wrapper,
  .post-header-inner,
  .prose-wrapper,
  .prose-inner,
  .toc-wrapper,
  .toc-inner,
  .adjacent-wrapper,
  .adjacent-inner {
    clip-path: polygon(
      0 0,
      calc(100% - var(--mono-chamfer-cut, 16px)) 0,
      100% var(--mono-chamfer-cut, 16px),
      100% 100%,
      var(--mono-chamfer-cut, 16px) 100%,
      0 calc(100% - var(--mono-chamfer-cut, 16px))
    );
  }

  .post-header-wrapper,
  .prose-wrapper,
  .toc-wrapper,
  .adjacent-wrapper {
    background-color: var(--mono-grid);
    padding: var(--mono-border-w, 0.7px);
    width: 100%;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .post-header-inner,
  .prose-inner,
  .toc-inner,
  .adjacent-inner {
    background-color: var(--mono-card-bg);
    color: var(--mono-ink);
  }

  .adjacent-wrapper:hover {
    transform: translateY(-2px);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono-font-mono);
    font-size: 11px;
    color: var(--mono-muted);
    margin-bottom: 24px;
    overflow-x: auto;
    white-space: nowrap;
  }

  .breadcrumb a {
    color: var(--mono-l2);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--mono-ink);
    text-decoration: underline;
  }

  .crumb-sep {
    color: var(--mono-faint);
  }

  .crumb-current {
    color: var(--mono-muted);
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 320px;
  }

  .post-header-wrapper {
    margin-bottom: 36px;
  }

  .post-header-inner {
    padding: 36px 32px 28px;
  }

  .card-tag {
    font-family: var(--mono-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--mono-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono-font-mono);
    font-size: 11.5px;
    color: var(--mono-muted);
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--mono-ink);
    margin: 0 0 12px 0;
  }

  .post-subtitle {
    font-size: 1.05rem;
    color: var(--mono-l3);
    line-height: 1.65;
    margin: 0 0 24px 0;
  }

  .post-meta-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    border-top: 0.7px dashed var(--mono-grid);
    flex-wrap: wrap;
    gap: 16px;
  }

  .author-inline {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-mini-avatar {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    object-fit: cover;
    display: block;
    border: 0.7px solid var(--mono-grid);
  }

  .author-meta {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    font-size: 13px;
    color: var(--mono-ink);
  }

  .author-title {
    font-size: 10.5px;
    font-family: var(--mono-font-mono);
    color: var(--mono-muted);
  }

  .post-content-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 36px;
    align-items: flex-start;
  }

  .prose-inner {
    padding: 40px 36px;
    min-width: 0;
  }

  /* Typography styles inside article */
  .prose-inner :global(h2) {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--mono-ink);
    margin-top: 40px;
    margin-bottom: 18px;
    padding-bottom: 8px;
    border-bottom: 0.7px solid var(--mono-grid);
  }

  .prose-inner :global(h3) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--mono-ink);
    margin-top: 28px;
    margin-bottom: 14px;
  }

  .prose-inner :global(p) {
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--mono-l2);
    margin-bottom: 20px;
  }

  .prose-inner :global(ul), .prose-inner :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
    color: var(--mono-l2);
    font-size: 14px;
    line-height: 1.7;
  }

  .prose-inner :global(li) {
    margin-bottom: 8px;
  }

  .prose-inner :global(strong) {
    color: var(--mono-ink);
    font-weight: 700;
  }

  .prose-inner :global(blockquote) {
    border-left: 3px solid var(--mono-ink);
    background: var(--mono-bg-subtle);
    padding: 16px 22px;
    border-radius: 0 var(--mono-tag-radius) var(--mono-tag-radius) 0;
    margin: 24px 0;
    font-style: italic;
    color: var(--mono-l2);
  }

  .prose-inner :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 13px;
  }

  .prose-inner :global(th), .prose-inner :global(td) {
    padding: 12px 16px;
    border: 0.7px solid var(--mono-grid);
    text-align: left;
  }

  .prose-inner :global(th) {
    background: var(--mono-bg-subtle);
    font-family: var(--mono-font-mono);
    font-size: 11.5px;
    font-weight: 700;
    color: var(--mono-ink);
  }

  .post-tags-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 24px;
    margin-top: 40px;
    border-top: 0.7px dashed var(--mono-grid);
    flex-wrap: wrap;
  }

  .tags-label {
    font-family: var(--mono-font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--mono-muted);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Sidebar TOC */
  .post-sidebar {
    position: sticky;
    top: 90px;
  }

  .toc-inner {
    padding: 24px 20px;
  }

  .toc-header {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 0.7px solid var(--mono-grid);
  }

  .toc-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .toc-item a {
    font-size: 12px;
    color: var(--mono-l3);
    text-decoration: none;
    line-height: 1.4;
    display: block;
    transition: color 0.15s ease;
  }

  .toc-item a:hover {
    color: var(--mono-ink);
    text-decoration: underline;
  }

  .toc-item.depth-3 {
    padding-left: 12px;
    font-size: 11px;
    border-left: 0.7px solid var(--mono-grid);
  }

  .post-footer-section {
    margin-top: 44px;
  }

  .nav-adjacent-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 32px;
  }

  .adjacent-wrapper {
    display: flex;
    text-decoration: none;
  }

  .adjacent-inner {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 20px;
    width: 100%;
    height: 100%;
  }

  .adjacent-inner.next-align {
    text-align: right;
  }

  .adjacent-label {
    font-family: var(--mono-font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--mono-muted);
  }

  .adjacent-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--mono-ink);
    line-height: 1.4;
  }

  .back-home-wrap {
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  @media (max-width: 860px) {
    .post-content-layout {
      grid-template-columns: 1fr;
    }
    .post-sidebar {
      display: none;
    }
    .post-header-inner {
      padding: 26px 20px;
    }
    .prose-inner {
      padding: 26px 20px;
    }
    .nav-adjacent-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
