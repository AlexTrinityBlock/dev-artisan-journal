---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import { defaultLang, langMeta, locales, type Lang } from '../i18n/config';
import { localeHref, stripLang } from '../i18n/utils';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  /** Locale-less paths for the pages that actually exist in each language. */
  alternates?: Partial<Record<Lang, string>>;
}

const {
  lang,
  title = useTranslations(lang).site.title,
  description = useTranslations(lang).site.description,
  image = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/avatar/avatar.jpg`,
  article = false,
  alternates,
} = Astro.props;

const t = useTranslations(lang);
const meta = langMeta[lang];
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = stripLang(Astro.url.pathname);

// Absolute URLs (hreflang, canonical, og:url) need an origin.
const origin = Astro.site ?? new URL(Astro.url.origin);
const absolute = (href: string) => new URL(href, origin).href;

// Emit hreflang only for pages that exist in that language.
const alternatePaths: Partial<Record<Lang, string>> =
  alternates ?? Object.fromEntries(locales.map((locale) => [locale, path]));
const alternateLinks = locales
  .filter((locale) => alternatePaths[locale] !== undefined)
  .map((locale) => ({
    lang: locale,
    hreflang: langMeta[locale].hreflang,
    href: absolute(localeHref(locale, alternatePaths[locale] ?? path)),
  }));
const xDefault = absolute(localeHref(defaultLang, alternatePaths[defaultLang] ?? path));
const canonical = absolute(localeHref(lang, alternatePaths[lang] ?? path));
---

<!DOCTYPE html>
<html lang={meta.htmlLang} dir={meta.dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />

  <!-- Canonical, hreflang alternates & OpenGraph -->
  <link rel="canonical" href={canonical} />
  {alternateLinks.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={xDefault} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:locale" content={meta.ogLocale} />
  {locales
    .filter((locale) => locale !== lang && alternatePaths[locale] !== undefined)
    .map((locale) => (
      <meta property="og:locale:alternate" content={langMeta[locale].ogLocale} />
    ))}
  <meta property="og:image" content={absolute(image)} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- KaTeX Math Rendering -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
</head>
<body>
  <!-- Global Top Header -->
  <Header
    lang={lang}
    missing={locales.filter((locale) => alternatePaths[locale] === undefined)}
  />

  <!-- Main Content Area -->
  <main id="main-content" class="main-wrapper">
    <slot />
  </main>

  <!-- Global Footer -->
  <Footer lang={lang} />

  <!-- Global Toast -->
  <div id="toast" class="toast-box">{t.toast.copied}</div>

  <style>
    .main-wrapper {
      flex: 1 0 auto;
      padding: 36px 0 64px;
    }

    .toast-box {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--mono-ink);
      color: var(--mono-paper);
      padding: 10px 18px;
      border-radius: 8px;
      font-family: var(--mono-font-mono);
      font-size: 11px;
      font-weight: 600;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      z-index: 9999;
    }

    .toast-box.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script is:inline define:vars={{ toastFallback: t.toast.copied }}>
    function showToast(message) {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = message || toastFallback;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }
  </script>
</body>
</html>
