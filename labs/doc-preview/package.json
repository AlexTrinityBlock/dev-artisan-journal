{
  "name": "doc-preview-lab",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "samples": "bun scripts/generate-samples.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test worker/test",
    "e2e": "bun scripts/e2e.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml --port 8788",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "audit": "bun audit",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "worker:smoke": "bun scripts/worker-smoke.mjs",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "verify": "bun run check && bun run e2e && bun run worker:smoke"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "pptxviewjs": "^1.1.9",
    "round": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@cloudflare/workers-types": "^5.20261122.2",
    "@types/bun": "^1.3.6",
    "docx": "^9.16.0",
    "playwright-core": "^1.58.0",
    "pptxgenjs": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
